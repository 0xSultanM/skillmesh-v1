{
  "version": 2,
  "buildCommand": "bash build.sh",
  "builds": [
    {"src": "staticfiles/**/*", "use": "@vercel/static"},
    {"src": "skillmesh/wsgi.py", "use": "@vercel/python"}
  ],
  "routes": [
    {"src": "/static/(.*)", "dest": "/staticfiles/$1"},
    {"src": "/(.*)", "dest": "skillmesh/wsgi.py"}
  ]
}
