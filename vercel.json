{
  "version": 2,
  "buildCommand": "bash build.sh",
  "outputDirectory": "staticfiles",
  "builds": [
    {
      "src": "skillmesh/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "skillmesh/wsgi.py"
    }
  ]
}
